#!/bin/sh
# Canary stand-in for the claude CLI inside the roost container.
# Probe/print modes pass straight through to mock-agent; interactive
# launches print the sandbox probe report, then hold an interactive shell
# so reattach/spectate/kill flows have a live session to act on.
case "$*" in
  *--version*) exec /usr/local/bin/mock-agent "$@" ;;
  *" -p "*|"-p "*|*" -p") exec /usr/local/bin/mock-agent "$@" ;;
esac
/usr/local/bin/mock-agent "$@"
echo ""
echo "CANARY_SHELL_READY user=$(id -un) host=$(hostname) cwd=$(pwd)"
exec /bin/sh -i
